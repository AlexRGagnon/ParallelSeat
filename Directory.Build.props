<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Company>ParallelSeat</Company>
    <Product>ParallelSeat</Product>
    <Authors>ParallelSeat</Authors>
    <Copyright>Copyright (c) ParallelSeat contributors</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'ParallelSeat.Core' AND '$(MSBuildProjectName)' != 'ParallelSeat.Protocol' AND '$(MSBuildProjectName)' != 'ParallelSeat.Adapters.Abstractions'">
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ParallelSeat.Core' OR '$(MSBuildProjectName)' == 'ParallelSeat.Protocol' OR '$(MSBuildProjectName)' == 'ParallelSeat.Adapters.Abstractions'">
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
</Project>
